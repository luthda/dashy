# ─── Yarn (Berry 3.6) ─────────────────────────────────────────────────────────
# This project standardises on Yarn 3.6 (yarn.lock is the source of truth, committed).
# Yarn's generated artifacts (.yarn/cache, install-state.gz) are ignored in
# frontend/.gitignore — Berry's patterns must live next to its .yarnrc.yml.
.pnp.*
# Standardised on Yarn — keep a stray `npm install` from committing an npm lockfile.
package-lock.json

# ─── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── SQLite ───────────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ─── Docker ───────────────────────────────────────────────────────────────────
# Keep docker-compose.yml but ignore any local overrides
docker-compose.override.yml

